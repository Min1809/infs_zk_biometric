<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View for Biometric Device Users -->
    <record id="view_biometric_device_user_search" model="ir.ui.view">
        <field name="name">biometric.device.user.search</field>
        <field name="model">biometric.device.user</field>
        <field name="arch" type="xml">
            <search string="Search Device Users">
                <field name="user_id" string="Biometric Device ID"/>
                <field name="name" string="Name on Device"/>
                <field name="employee_id" string="Linked Employee"/>
                <field name="department_id" string="Department"/>
                <field name="device_id" string="Biometric Device"/>
                <field name="card" string="Card Number"/>

                <filter string="Linked to Employee" name="filter_linked"
                        domain="[('employee_id', '!=', False)]"/>
                <filter string="Unlinked (Not in Employee)" name="filter_unlinked"
                        domain="[('employee_id', '=', False)]"/>
                <separator/>
                <filter string="Admins / Managers" name="filter_admins"
                        domain="[('privilege', 'in', ('6', '14'))]"/>

                <group expand="0" string="Group By">
                    <filter string="Biometric Device" name="group_by_device"
                            context="{'group_by': 'device_id'}"/>
                    <filter string="Linked Employee" name="group_by_employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter string="Department" name="group_by_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Privilege" name="group_by_privilege"
                            context="{'group_by': 'privilege'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Tree View for Biometric Device Users -->
    <record id="view_biometric_device_user_tree" model="ir.ui.view">
        <field name="name">biometric.device.user.tree</field>
        <field name="model">biometric.device.user</field>
        <field name="arch" type="xml">
            <tree string="Device User List" default_order="device_id, uid asc">
                <header>
                    <button name="action_sync_all_devices"
                            string="Sync Users from Devices"
                            type="object"
                            class="btn-primary"
                            display="always"
                            icon="fa-refresh"/>
                </header>
                <field name="user_id" string="Biometric Device ID" decoration-bf="1"/>
                <field name="name" string="Name on Device"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" optional="show"/>
                <field name="device_id"/>
                <field name="privilege" widget="badge"
                       decoration-info="privilege == '0'"
                       decoration-warning="privilege in ('2', '6')"
                       decoration-danger="privilege == '14'"/>
                <field name="uid" string="Device UID" optional="show"/>
                <field name="card" optional="hide"/>
                <field name="group_id" optional="hide"/>
                <field name="last_sync_date" optional="show"/>
                <button name="action_create_or_link_employee"
                        string="Create / Link Employee"
                        type="object"
                        icon="fa-user-plus"
                        class="btn-link"
                        invisible="employee_id != False"/>
                <button name="action_delete_from_device"
                        string="Remove from Device"
                        type="object"
                        icon="fa-trash"
                        class="text-danger"
                        confirm="Are you sure you want to delete this user from the physical Biometric Device?"/>
            </tree>
        </field>
    </record>

    <!-- Form View for Biometric Device Users -->
    <record id="view_biometric_device_user_form" model="ir.ui.view">
        <field name="name">biometric.device.user.form</field>
        <field name="model">biometric.device.user</field>
        <field name="arch" type="xml">
            <form string="Biometric Device User">
                <header>
                    <button name="action_push_to_device"
                            string="Push / Update to Device"
                            type="object"
                            class="oe_highlight"
                            icon="fa-upload"/>
                    <button name="action_create_or_link_employee"
                            string="Create / Link Odoo Employee"
                            type="object"
                            class="btn-secondary"
                            icon="fa-user-plus"
                            invisible="employee_id != False"/>
                    <button name="action_delete_from_device"
                            string="Delete from Device"
                            type="object"
                            class="btn-danger"
                            icon="fa-trash"
                            confirm="Are you sure you want to delete this user from the physical Biometric Device?"/>
                </header>
                <sheet>
                    <group>
                        <group string="Device User Information">
                            <field name="device_id"/>
                            <field name="user_id"/>
                            <field name="name"/>
                            <field name="uid" readonly="1"/>
                            <field name="privilege"/>
                        </group>
                        <group string="Odoo Employee Link &amp; Details">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="card"/>
                            <field name="group_id"/>
                            <field name="last_sync_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action for Device User List -->
    <record id="biometric_device_user_action" model="ir.actions.act_window">
        <field name="name">Device User List</field>
        <field name="res_model">biometric.device.user</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_biometric_device_user_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No biometric device users synced yet.
            </p>
            <p>
                Click <strong>Sync Users from Devices</strong> at the top of the list to fetch users from your ZKTeco fingerprint devices, or create users directly from the Employee form.
            </p>
        </field>
    </record>

    <!-- Menu Item under Biometric Device (hr_zk_attendance.biometric_device_details_menu) -->
    <menuitem id="biometric_device_user_menu"
              name="Device User List"
              action="biometric_device_user_action"
              parent="hr_zk_attendance.biometric_device_details_menu"
              sequence="22"
              groups="hr_attendance.group_hr_attendance_officer"/>
</odoo>

