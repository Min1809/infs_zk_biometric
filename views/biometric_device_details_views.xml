<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherited Biometric Device Form View -->
    <record id="view_biometric_device_details_form_inherit_infs" model="ir.ui.view">
        <field name="name">biometric.device.details.form.inherit.infs</field>
        <field name="model">biometric.device.details</field>
        <field name="inherit_id" ref="hr_zk_attendance.biometric_device_details_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sync_device_users"
                        string="Sync Users"
                        type="object"
                        class="btn-secondary"
                        icon="fa-users"
                        help="Fetch all users and fingerprint counts stored on this biometric device into Odoo Device User List"/>
                <button name="action_sync_fingerprints_to_other_devices"
                        string="Sync Fingerprints to Other Devices"
                        type="object"
                        class="btn-secondary"
                        icon="fa-hand-pointer-o"
                        help="Copy all users and enrolled fingerprint templates from this device (e.g. Entrance) to all other configured devices (e.g. Exit)"/>
            </xpath>
            <xpath expr="//sheet/group" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_device_users"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-users">
                        <field name="device_user_count" widget="statinfo" string="Device Users"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='address_id']" position="after">
                <field name="device_tz"/>
                <field name="device_type" widget="radio"/>
            </xpath>
        </field>
    </record>

    <!-- Inherited Biometric Device Tree View -->
    <record id="view_biometric_device_details_tree_inherit_infs" model="ir.ui.view">
        <field name="name">biometric.device.details.tree.inherit.infs</field>
        <field name="model">biometric.device.details</field>
        <field name="inherit_id" ref="hr_zk_attendance.biometric_device_details_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='port_number']" position="after">
                <field name="device_tz"/>
                <field name="device_type"/>
                <field name="device_user_count" string="Users"/>
            </xpath>
        </field>
    </record>
</odoo>
